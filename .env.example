MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional override. On Vercel this is derived automatically; set your production
# custom domain (https://example.com) here so OAuth callbacks use the right host.
# BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated exact origins for custom preview/deployment domains
# BETTER_AUTH_TRUSTED_ORIGINS=https://auth-dev.example.com

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional app settings
# MONGODB_DATABASE=bazar-dor
# BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
